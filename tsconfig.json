{
    "compilerOptions": {
        "target": "es2021",
        "module": "node16",
        "declaration": true,
        "outDir": "lib",
        "rootDir": ".",
        "moduleResolution": "node16",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": ["node", "jest"]
    },
    "include": ["src", "test"]
}
